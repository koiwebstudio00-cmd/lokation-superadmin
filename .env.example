BETTER_AUTH_URL=http://localhost:3003
# Generar un secreto distinto para cada panel: openssl rand -hex 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
